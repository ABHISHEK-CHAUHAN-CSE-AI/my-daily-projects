    <!-- PROGRAM 5 -->
    <div class="page">
        <div class="title">Program - 5: Checking if a Number is Odd or Even</div>
<pre>
#include &lt;stdio.h&gt;

int main() 
{
    int num;

    printf("Enter an integer: ");
    scanf("%d", &num);

    if (num % 2 == 0)
    {
        printf("%d is even\n", num);
    }
    else
    {
        printf("%d is odd\n", num);
    }

    return 0;
}
</pre>

        <div class="output-heading">OUTPUT</div>
        <div class="output-box">
Enter an integer: 6<br>
6 is even
        </div>
    </div>

    <!-- PROGRAM 6 -->
    <div class="page">
        <div class="title">Program - 6: Program to Find the Largest of Two Numbers</div>
<pre>
#include &lt;stdio.h&gt;

int main()
{
    int num1, num2;

    printf("Enter two integers: ");
    scanf("%d %d", &num1, &num2);

    if (num1 > num2)
    {
        printf("%d is the largest number.\n", num1);
    }
    else if (num2 > num1)
    {
        printf("%d is the largest number.\n", num2);
    }
    else
    {
        printf("Both numbers are equal.\n");
    }

    return 0;
}
</pre>

        <div class="output-heading">OUTPUT</div>
        <div class="output-box">
Enter two integers: 15 28<br>
28 is the largest number.
        </div>
